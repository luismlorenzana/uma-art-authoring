{
  "name": "uma-art-authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "private-art": "node --import tsx tools/private-art.ts",
    "private-art:owner": "node --import tsx tools/private-art-owner.ts",
    "originals": "node --import tsx tools/prepare-originals.ts",
    "duos": "node --import tsx tools/prepare-duos.ts",
    "gallery": "node --import tsx src/gallery.ts",
    "albums": "node albums/build.mjs",
    "test": "node --test tools/beach.check.mjs && vitest run",
    "lint": "tsc --noEmit",
    "publish": "node --import tsx src/push.ts",
    "status": "node --import tsx src/status.ts",
    "cast": "node --import tsx src/cast.ts",
    "study": "node tools/splash-study.mjs",
    "rosters": "node tools/prepare-rosters.mjs",
    "farm:categories": "node --import tsx tools/prepare-farm-categories.ts",
    "farm:expressions": "node --import tsx tools/farm-expressions.mjs",
    "cyberpunk:categories": "node --import tsx tools/prepare-character-categories.ts --universe cyberpunk"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
